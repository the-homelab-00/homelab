{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'docker:enableMajor',
    'replacements:k8s-registry-move',
    ':automergeBranch',
    ':disableRateLimiting',
    ':dependencyDashboard',
    ':semanticCommits',
    ':skipStatusChecks',
    ':timezone(Europe/London)',
    'github>the-homelab-00/homelab//.github/renovate/allowedVersions.json5',
    'github>the-homelab-00/homelab//.github/renovate/autoMerge.json5',
    'github>the-homelab-00/homelab//.github/renovate/commitMessage.json5',
    'github>the-homelab-00/homelab//.github/renovate/customManagers.json5',
    'github>the-homelab-00/homelab//.github/renovate/grafanaDashboards.json5',
    'github>the-homelab-00/homelab//.github/renovate/groups.json5',
    'github>the-homelab-00/homelab//.github/renovate/labels.json5',
    'github>the-homelab-00/homelab//.github/renovate/packageRules.json5',
    'github>the-homelab-00/homelab//.github/renovate/semanticCommits.json5',
  ],
  dependencyDashboardTitle: 'Renovate Dashboard 🤖',
  packageRules: [
    {
      // Their guest-watch-together tag moves with every dev build; they're pinned through PRs,
      // as a new digest rolled out by itself replaces the transcoder mid-conversion.
      description: 'AIOStreams fork images: pinned by hand',
      matchDatasources: ['docker'],
      matchPackageNames: [
        'ghcr.io/thepotato97/aiostreams',
        'ghcr.io/thepotato97/aiostreams-transcoder',
      ],
      enabled: false,
    },
  ],
  suppressNotifications: [
    'prEditedNotification',
    'prIgnoreNotification',
  ],
  ignorePaths: [
    '**/*.sops.*',
    '**/.archive/**',
    '**/resources/**',
    'bootstrap/templates/kubernetes/flux/repositories/helm/**',
  ],
  flux: {
    managerFilePatterns: [
      '/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  'helm-values': {
    managerFilePatterns: [
      '/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  kubernetes: {
    managerFilePatterns: [
      '/(^|/)\\.taskfiles/.+\\.ya?ml(?:\\.j2)?$/',
      '/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/',
    ],
  },
}
