{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackagePatterns": ["kopia"],
      "allowedVersions": "<999"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackagePatterns": ["postgresql"],
      "allowedVersions": "<17"
    },
    {
      // emqx-operator and the EMQX image are version-coupled: 2.3.x supports
      // only EMQX 5.9/5.10/6.x, and 2.2.x cannot be restored once 2.3.x has
      // added the v2 CRD version (emqx/emqx-operator#1202). Bump the operator
      // only together with the image in emqx/cluster/cluster.yaml.
      "matchDatasources": ["helm"],
      "matchPackageNames": ["emqx-operator"],
      "enabled": false
    }
  ]
}
